{
  "name": "ts-selenium-framework-template",
  "version": "0.1.0",
  "private": true,
  "description": "UI test automation template: TypeScript + selenium-webdriver + Mocha \u2014 a fresh browser per test, page objects, explicit waits, data from JSON with zod, failure evidence, local or Grid. DRAFT \u2014 made real on lab11.",
  "type": "module",
  "scripts": {
    "test": "mocha",
    "check": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/selenium-webdriver": "4.35.7",
    "eslint": "10.12.0",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "selenium-webdriver": "4.49.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "zod": "4.6.6"
  },
  "engines": {
    "node": ">=22"
  }
}
